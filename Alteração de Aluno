<?php

$matricula = $_POST["matricula"];

$nome = "";
$email = "";

if (file_exists("alunos.txt")) {

    $arqAluno = fopen("alunos.txt", "r");

    while (!feof($arqAluno)) {

        $linha = fgets($arqAluno);

        if ($linha != false) {

            $dados = explode(";", trim($linha));

            if ($dados[0] == $matricula) {

                $nome = $dados[1];
                $email = $dados[2];

            }
        }
    }

    fclose($arqAluno);
}

?>

