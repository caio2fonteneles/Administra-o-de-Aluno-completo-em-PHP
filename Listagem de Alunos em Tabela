if (file_exists("alunos.txt")) {

    $arqAluno = fopen("alunos.txt", "r");

    while (!feof($arqAluno)) {

        $linha = fgets($arqAluno);

        if ($linha != false) {

            $dados = explode(";", trim($linha));

            // Não mostra o cabeçalho
            if ($dados[0] != "matricula") {

                echo "<tr>";

                echo "<td>" . $dados[0] . "</td>";
                echo "<td>" . $dados[1] . "</td>";
                echo "<td>" . $dados[2] . "</td>";

                echo "<td>";

                echo "<form action='mostrarAlterarAluno.php' method='POST' style='display:inline'>";
                echo "<input type='hidden' name='matricula' value='" . $dados[0] . "'>";
                echo "<input type='submit' value='Alterar'>";
                echo "</form>";

                echo " ";

                echo "<form action='mostrarExcluirAluno.php' method='POST' style='display:inline'>";
                echo "<input type='hidden' name='matricula' value='" . $dados[0] . "'>";
                echo "<input type='submit' value='Excluir'>";
                echo "</form>";

                echo "</td>";

                echo "</tr>";
            }
        }
    }

    fclose($arqAluno);
}

